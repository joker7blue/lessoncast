# Meta Model API (Muse Spark, Muse Image, SAM 3.1) — https://dev.meta.ai/docs/models
# Auth: "Authorization: Bearer $MODEL_API_KEY", base URL https://api.meta.ai/v1
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Modal (MMS-TTS, MMS forced alignment, Omnilingual ASR).
# Optional if you already ran `modal setup` (token stored in ~/.modal.toml).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Supabase (database + storage) — same variable names as BuildStory AI
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Trigger.dev (dev key from the lessoncast project)
TRIGGER_SECRET_KEY=

# Postgres connection string (Supabase > Connect > Session pooler), used by psql for migrations
SUPABASE_DB_URL=

# Salt for hashing visitor IPs (rate limiting)
IP_HASH_SALT=

# Lesson limits for the open site: off unless true. Defaults: 3 per IP per hour, 60 per day for everyone.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_IP_HOUR=3
RATE_LIMIT_PER_DAY=60

# Upstash Redis for those limits (the Vercel integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
